    pcrbase:hasRequirement [ pcrbase:clauseKey "id.valid_until" ; pcrbase:cometTarget "comet-pcf:PCRDocument.validUntil" ; pcrbase:mappingStatus "extended" ; pcrbase:confidence "0.99"^^xsd:decimal ; pcrbase:value "2026-06-30" ] ;
