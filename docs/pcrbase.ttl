    pcrbase:hasRequirement [ pcrbase:clauseKey "lcia.biogenic" ; pcrbase:cometTarget "comet-pcf:biogenicCarbon" ; pcrbase:mappingStatus "exact" ; pcrbase:confidence "0.85"^^xsd:decimal ; pcrbase:value "Emissions from detonation calculated from balanced chemical reaction at final state and 1 bar" ] ;
    pcrbase:hasRequirement [ pcrbase:clauseKey "id.pub_date" ; pcrbase:cometTarget "comet-pcf:PCRDocument.validFrom" ; pcrbase:mappingStatus "extended" ; pcrbase:confidence "0.99"^^xsd:decimal ; pcrbase:value "2021-11-20" ] ;
