pcrbase:epd-norge-26813257e530-5804 a comet-pcf:PCRDocument ;
    dcterms:title "NPCR 024 Explosives and Initiation Systems (references to EN 15804+A2)" ;
    comet-pcf:pcrNumber "NPCR 024" ;
    comet-pcf:version "5804" ;
    comet-pcf:validUntil "2026-06-30"^^xsd:date ;
    comet-pcf:programOperator pcrbase:operator-epd-norge ;
    prov:wasDerivedFrom <https://www.epd-global.com/pcr/epd-norges-pcr-register/> ;
    pcrbase:hasRequirement [ pcrbase:clauseKey "boundary.type" ; pcrbase:cometTarget "comet-pcf:SystemBoundary" ; pcrbase:mappingStatus "exact" ; pcrbase:confidence "0.95"^^xsd:decimal ; pcrbase:value "Cradle-to-gate (A1-A3) with mandatory modules A4, A5, C1-C4, D; or cradle-to-gate (A1-A3) with mandatory A4, A5 only" ] ;
    pcrbase:hasRequirement [ pcrbase:clauseKey "id.standard_basis" ; pcrbase:cometTarget "comet-pcf:StandardRef" ; pcrbase:mappingStatus "exact" ; pcrbase:confidence "0.95"^^xsd:decimal ; pcrbase:value "EN 15804+A2, ISO 14044:2006, ISO 14025:2006" ] ;
